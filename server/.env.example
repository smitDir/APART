PORT=3000

# CORS: origin of the landing page
ALLOWED_ORIGIN=https://radegust.ru

# MySQL — each project/vertical gets its own database on the shared VPS
# MySQL server (DB_NAME differs per project, same DB_USER/DB_PASSWORD or a
# dedicated user per database — your call when provisioning).
DB_HOST=localhost
DB_PORT=3306
DB_USER=apart
DB_PASSWORD=
DB_NAME=apart

# YooKassa (https://yookassa.ru/my/merchant/integration/api-keys)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Telegram bot token from @BotFather — used both for manager notifications
# and to run the customer-facing booking bot (server/src/bot).
TELEGRAM_BOT_TOKEN=
# Chat/group id where new-booking notifications are sent to the manager
# (not the public channel — that's just where the bot's link gets shared).
TELEGRAM_CHAT_ID=

# Admin panel (GET /api/admin/bookings) — HTTP Basic Auth
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# /admin/... (web UI, e.g. /admin/request) — separate DB-backed login
# (admin_users table). ADMIN_USER/ADMIN_PASSWORD above are only used once, to
# seed the first admin_users row on first boot; change credentials afterwards
# with: node scripts/set-admin-password.js <username> <password>
# SESSION_SECRET signs the login cookie — set it to a long random string.
SESSION_SECRET=change-me

# Public URL of this API, used to build YooKassa return_url
PUBLIC_API_URL=http://localhost:3000
# Where to send the guest back to after paying
BOOKING_RETURN_URL=https://radegust.ru/lending/apart/

# Public Telegram channel to post scheduled content to (bot must be admin there)
TELEGRAM_CHANNEL_ID=

# Manager group/channel for new-booking notifications, separate from the
# personal TELEGRAM_CHAT_ID above. Must be a numeric chat_id, not an invite
# link (t.me/+... links can't be resolved to a chat_id via the Bot API) —
# add the bot to the group as admin, then read the chat_id off any update
# the bot receives there (e.g. forward a message through @RawDataBot, or
# temporarily log msg.chat.id in bot/index.js).
TELEGRAM_MANAGER_CHANNEL_ID=

# SMTP — sends booking-confirmation emails to guests (when they pick "email"
# as their notification channel) and new-booking alerts to sale@radegust.ru.
# Any SMTP provider works (Yandex 360, Gmail app password, etc). Without
# these, emails are just logged to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=sale@radegust.ru

# Free-tier conversational AI layer for the bot's free-text replies.
# Get a key at https://aistudio.google.com/apikey (Google AI Studio, free tier).
GEMINI_API_KEY=
# Override if Google renames/retires the free-tier model.
GEMINI_MODEL=gemini-2.5-flash

# OpenAI Whisper API — transcribes guests' voice messages in the bot to text.
# Get a key at https://platform.openai.com/api-keys. Without it, voice messages
# get a "not supported" reply instead of failing.
OPENAI_API_KEY=

# YouTube Data API v3 (video publishing) — Google Cloud Console OAuth client
# (type "Desktop app"). Get YOUTUBE_REFRESH_TOKEN by running, once, on your
# own computer (needs a browser): node src/content/youtubeAuth.js
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
