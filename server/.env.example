PORT=3000

# CORS: origin of the landing page
ALLOWED_ORIGIN=https://radegust.ru

# YooKassa (https://yookassa.ru/my/merchant/integration/api-keys)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Telegram bot token from @BotFather — used both for manager notifications
# and to run the customer-facing booking bot (server/src/bot).
TELEGRAM_BOT_TOKEN=
# Chat/group id where new-booking notifications are sent to the manager
# (not the public channel — that's just where the bot's link gets shared).
TELEGRAM_CHAT_ID=

# Admin panel (GET /api/admin/bookings) — HTTP Basic Auth
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Public URL of this API, used to build YooKassa return_url
PUBLIC_API_URL=http://localhost:3000
# Where to send the guest back to after paying
BOOKING_RETURN_URL=https://radegust.ru/lending/apart/

# Public Telegram channel to post scheduled content to (bot must be admin there)
TELEGRAM_CHANNEL_ID=
